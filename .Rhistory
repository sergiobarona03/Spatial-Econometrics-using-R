range(card(nb2_mun$neighbours))  # Rango (número de vecinos)
1/rev(range(card(nb2_mun$neighbours))) # Rango (pesos)
1/rev(range(card(nb2_mun$neighbours))) # Rango (pesos)
summary(nb2_mun, zero.policy=T)   # Resumen
moran.test(reg_mco$residuals,
